APP_NAME="Lokon Dokumen Digital"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://contoh-domain-anda.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ypl_sdl
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=2880
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true
# Wajib true bila APP_URL https (jangan aktifkan di http lokal)
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Mail: tanpa SMTP, kode reset ditulis ke storage/logs/laravel.log (mode darurat).
# Production: pakai mailer sungguhan SMTP — kode reset kini dikirim ke email terdaftar.
MAIL_MAILER=log

# Ask YPL — LLM testing only (JANGAN dipakai production tanpa review).
# Kosongkan = mode ekstraktif (aman, tanpa panggilan HTTP).
# ASK_LLM_DRIVER=none
# GOOGLE_GEMINI_API_KEY=
# ASK_LLM_MODEL=gemini-3.8-flash
# ASK_LLM_BASE_URL=https://generativelanguage.googleapis.com
